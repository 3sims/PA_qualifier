NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — connexion à la base PA_selector
# Décommenter et renseigner pour activer le mode Supabase (V2).
# Sans ces variables, l'app utilise pa-seed-v1.json en local (V1).
#
# NEXT_PUBLIC_SUPABASE_URL   → Settings > API > Project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY → Settings > API > anon public key
# SUPABASE_SERVICE_ROLE_KEY  → Settings > API > service_role key (serveur uniquement)
#
# Même projet que PA_selector : SUPABASE_URL = NEXT_PUBLIC_SUPABASE_URL
#                               SUPABASE_SERVICE_KEY = SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
